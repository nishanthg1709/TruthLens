# TruthLens Backend API Configuration
# Default is http://127.0.0.1:8000
VITE_TRUTHLENS_API_URL=http://127.0.0.1:8000

# Analysis endpoint (mounted at /api/v1/analyze)
VITE_TRUTHLENS_ANALYSIS_PATH=/api/v1/analyze

# Health check endpoint (mounted at /health)
VITE_TRUTHLENS_HEALTH_PATH=/health

# Request timeouts
VITE_TRUTHLENS_REQUEST_TIMEOUT_MS=60000
VITE_TRUTHLENS_STATUS_TIMEOUT_MS=10000
VITE_TRUTHLENS_POLL_INTERVAL_MS=1500
