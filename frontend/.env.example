# Configure only after the FastAPI backend contract is agreed.
VITE_TRUTHLENS_API_URL=

# Optional submission endpoints. Leave unset to use VITE_TRUTHLENS_ANALYSIS_PATH.
VITE_TRUTHLENS_ANALYSIS_PATH=
VITE_TRUTHLENS_IMAGE_ANALYSIS_PATH=
VITE_TRUTHLENS_VIDEO_ANALYSIS_PATH=
VITE_TRUTHLENS_AUDIO_ANALYSIS_PATH=
VITE_TRUTHLENS_TEXT_ANALYSIS_PATH=

# Optional asynchronous contract paths.
VITE_TRUTHLENS_STATUS_PATH=
VITE_TRUTHLENS_HEALTH_PATH=

# Optional frontend defaults.
VITE_TRUTHLENS_REQUEST_TIMEOUT_MS=30000
VITE_TRUTHLENS_STATUS_TIMEOUT_MS=10000
VITE_TRUTHLENS_POLL_INTERVAL_MS=1500
