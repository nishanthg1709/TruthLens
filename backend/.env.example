# TruthLens backend configuration (safe placeholders only)

APP_NAME=TruthLens
APP_VERSION=1.0.0
DEBUG=false

# Comma-separated frontend origins for CORS (Vite defaults included)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Upload / image safety limits
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_DIMENSION=12000
MAX_PIXEL_COUNT=40000000
